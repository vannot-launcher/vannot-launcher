{
  "name": "vannot-launcher",
  "version": "1.0.2",
  "description": "Vannot Minecraft Java Launcher",
  "author": "Vannot",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:official-install": "node scripts/minecraft-install-smoke.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "id.dinastixd.launcher",
    "productName": "Vannot Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/vannot.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Vannot-Launcher-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  },
  "dependencies": {
    "@xmcl/core": "^2.15.1",
    "@xmcl/forge-site-parser": "^2.0.9",
    "@xmcl/installer": "^6.1.2",
    "@xmcl/unzip": "2.1.2",
    "msmc": "^5.0.5"
  },
  "overrides": {
    "@xmcl/file-transfer": "2.1.4",
    "@xmcl/unzip": "2.1.2",
    "undici": "7.30.1"
  }
}
